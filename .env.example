# URL publik website (dipakai sitemap, robots, metadata)
NEXT_PUBLIC_SITE_URL=https://kayzenacademia.id

# Supabase (server-only). Pakai SECRET key (sb_secret_...), JANGAN publishable/anon key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_API_KEY=sb_secret_xxxxxxxx

# NextAuth — NEXTAUTH_URL harus sama persis dengan domain produksi (https)
NEXTAUTH_URL=http://localhost:3000
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth (opsional; kosongkan keduanya untuk menonaktifkan login Google)
# Authorized redirect URI: https://<domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP untuk email OTP (wajib agar login/daftar via OTP berfungsi)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opsional: alamat pengirim bila berbeda dari SMTP_USER
SMTP_FROM=
# Buat dengan: openssl rand -base64 32 (berbeda dari NEXTAUTH_SECRET)
OTP_PEPPER=replace-with-a-second-long-random-secret

# Hanya untuk scripts/seed.mjs (tidak dipakai saat runtime)
SEED_ADMIN_EMAIL=admin@kayzenacademia.com
SEED_ADMIN_PASSWORD=
